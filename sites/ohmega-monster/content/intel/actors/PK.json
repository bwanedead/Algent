  "statements": [
    {
      "id": "st_c8015df9cea2",
      "speaker": "Representative of Pakistan",
      "role": "Delegate to the United Nations",
      "date": "2026-10-09",
      "text": "Condemned attacks on Saudi infrastructure and reaffirmed unwavering solidarity with Riyadh.",
      "is_quote": false,
      "signal": "reassurance",
      "stance": 1,
      "source_url": "https://press.un.org/en/2026/sc16471.doc.htm"
    },
    {
      "id": "st_cf86ce450d1f",
      "speaker": "Delegate of Pakistan",
      "role": "Delegate to the First Committee",
      "date": "2026-10-09",
      "text": "It is more than evident that there is no military solution to the conflict,",
      "is_quote": true,
      "signal": "other",
      "stance": 0,
      "source_url": "https://press.un.org/en/2026/gadis3766.doc.htm"
    },
    {
      "id": "st_59f822236b7f",
      "speaker": "Delegate of Pakistan",
      "role": "Delegate to the First Committee",
      "date": "2026-10-09",
      "text": "Pakistan acted as a mediator between Iran and the United States in an effort that culminated in a ceasefire.",
      "is_quote": false,
      "signal": "other",
      "stance": 1,
      "source_url": "https://press.un.org/en/2026/gadis3766.doc.htm"
    },
    {
      "id": "st_f5012e75fe0c",
      "speaker": "Delegate of Pakistan",
      "role": "Delegate to the First Committee",
      "date": "2026-10-09",
      "text": "Last year, India launched an unprovoked military assault against Pakistan.",
      "is_quote": true,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://press.un.org/en/2026/gadis3766.doc.htm"
    },
    {
      "id": "st_be887cf4f702",
      "speaker": "Delegate of Pakistan",
      "role": "Delegate to the First Committee",
      "date": "2026-10-09",
      "text": "Pakistan does not seek an arms race, but we have the capacity to defend ourselves as evidenced by our response in May 2025.",
      "is_quote": true,
      "signal": "warning",
      "stance": -1,
      "source_url": "https://press.un.org/en/2026/gadis3766.doc.htm"
    }
  ],
