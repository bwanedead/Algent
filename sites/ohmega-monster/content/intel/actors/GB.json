  "statements": [
    {
      "id": "st_ecdc88d2f76e",
      "speaker": "Eleanor Sanders",
      "role": "UK Human Rights Ambassador",
      "date": "2026-10-02",
      "text": "The UK is supporting this work with $7.5 million to the Human Rights Compliance Mechanism for the Gang Suppression Force, which will be delivered by the Office for the High Commissioner for Human Rights.",
      "is_quote": true,
      "signal": "commitment",
      "stance": 1,
      "source_url": "https://www.gov.uk/government/speeches/un-human-rights-council-63-uk-statement-on-the-interactive-dialogue-on-haiti"
    },
    {
      "id": "st_b655a0f7b479",
      "speaker": "Eleanor Sanders",
      "role": "UK Human Rights Ambassador",
      "date": "2026-10-02",
      "text": "Children associated with gangs must be treated as victims, not perpetrators.",
      "is_quote": true,
      "signal": "demand",
      "stance": 0,
      "source_url": "https://www.gov.uk/government/speeches/un-human-rights-council-63-uk-statement-on-the-interactive-dialogue-on-haiti"
    },
    {
      "id": "st_1553689170d7",
      "speaker": "Eleanor Sanders",
      "role": "UK Human Rights Ambassador",
      "date": "2026-10-02",
      "text": "What concrete steps can the Government of Haiti take to resource and implement DDR nationwide, and deliver the safe release and reintegration of children associated with armed groups?",
      "is_quote": true,
      "signal": "demand",
      "stance": 0,
      "source_url": "https://www.gov.uk/government/speeches/un-human-rights-council-63-uk-statement-on-the-interactive-dialogue-on-haiti"
    },
    {
      "id": "st_46bfc98aa766",
      "speaker": "Ambassador Holland",
      "role": "UK Ambassador to the OSCE",
      "date": "2026-10-02",
      "text": "The United Kingdom is deeply concerned by reports of the deteriorating humanitarian conditions in the temporarily occupied parts of Ukraine’s Kherson region, including Oleshky.",
      "is_quote": true,
      "signal": "accusation",
      "stance": -1,
      "source_url": "https://www.gov.uk/government/speeches/humanitarian-situation-in-oleshky-uk-statement-to-the-osce"
    },
    {
      "id": "st_2fb239bdd364",
      "speaker": "Ambassador Holland",
      "role": "UK Ambassador to the OSCE",
      "date": "2026-10-02",
      "text": "Russia must meet its obligations.",
      "is_quote": true,
      "signal": "demand",
      "stance": -1,
      "source_url": "https://www.gov.uk/government/speeches/humanitarian-situation-in-oleshky-uk-statement-to-the-osce"
    },
    {
      "id": "st_0b62749ae005",
      "speaker": "Ambassador Holland",
      "role": "UK Ambassador to the OSCE",
      "date": "2026-10-02",
      "text": "The United Kingdom will continue to support Ukraine and in doing so to draw attention to the human consequences of Russia’s war of aggression.",
      "is_quote": true,
      "signal": "commitment",
      "stance": 1,
      "source_url": "https://www.gov.uk/government/speeches/humanitarian-situation-in-oleshky-uk-statement-to-the-osce"
    },
    {
      "id": "st_d1d8ec305f11",
      "speaker": "Ambassador Holland",
      "role": "UK Ambassador to the OSCE",
      "date": "2026-10-02",
      "text": "It also documents a broader rise in civilian harm and attacks affecting humanitarian personnel and operations.",
      "is_quote": true,
      "signal": "accusation",
      "stance": -1,
      "source_url": "https://www.gov.uk/government/speeches/humanitarian-situation-in-oleshky-uk-statement-to-the-osce"
    },
    {
      "id": "st_e9dfbf401e2e",
      "speaker": "Eleanor Sanders",
      "role": "UK's Human Rights Ambassador",
      "date": "2026-10-02",
      "text": "Sixty three percent of those interviewed reported conflict-related sexual violence at Russian hands. This included rape, genital mutilation, electric shocks and beatings to the genitals, and forced nudity - inflicted to strip prisoners of dignity and humiliate them before fellow captives and guards, sometimes over years.",
      "is_quote": true,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://www.gov.uk/government/speeches/un-human-rights-council-63-uk-statement-for-the-interactive-dialogue-with-the-high-commissioner-on-the-oral-update-on-ukraine"
    }
  ],
