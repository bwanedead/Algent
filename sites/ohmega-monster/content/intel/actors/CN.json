  "statements": [
    {
      "id": "st_dd17548de306",
      "speaker": "Guo Jiakun",
      "role": "Foreign Ministry Spokesperson",
      "date": "2026-10-03",
      "text": "The strategic guidance provided by head-of-state diplomacy serves as the most important political underpinning for the steady and sustained advancement of China-Russia relations.",
      "is_quote": true,
      "signal": "reassurance",
      "stance": 2,
      "source_url": "https://www.mfa.gov.cn/eng/xw/fyrbt/lxjzh/202610/t20261003_12035482.html"
    },
    {
      "id": "st_423f7300b7f1",
      "speaker": "Guo Jiakun",
      "role": "Foreign Ministry Spokesperson",
      "date": "2026-10-03",
      "text": "China welcomes President Putin’s attendance at the APEC Economic Leaders’ Meeting in Shenzhen this November and stands ready to work with the Russian side for fruitful outcomes of the APEC “China Year.”",
      "is_quote": true,
      "signal": "commitment",
      "stance": 2,
      "source_url": "https://www.mfa.gov.cn/eng/xw/fyrbt/lxjzh/202610/t20261003_12035482.html"
    },
    {
      "id": "st_c8c64a51c31d",
      "speaker": "Guo Jiakun",
      "role": "Foreign Ministry Spokesperson",
      "date": "2026-10-03",
      "text": "As for your specific question, I have no information to offer at the moment.",
      "is_quote": true,
      "signal": "denial",
      "stance": 0,
      "source_url": "https://www.mfa.gov.cn/eng/xw/fyrbt/lxjzh/202610/t20261003_12035482.html"
    },
    {
      "id": "st_6cb3c42769dd",
      "speaker": "Guo Jiakun",
      "role": "Foreign Ministry Spokesperson",
      "date": "2026-10-03",
      "text": "China always acts prudently and responsibly on the export of military products, and exercises strict control over dual-use items in accordance with China’s laws and regulations on export control and due international obligations.",
      "is_quote": true,
      "signal": "policy_announcement",
      "stance": 0,
      "source_url": "https://www.mfa.gov.cn/eng/xw/fyrbt/lxjzh/202610/t20261003_12035482.html"
    },
    {
      "id": "st_0df656c23c76",
      "speaker": "Guo Jiakun",
      "role": "Foreign Ministry Spokesperson",
      "date": "2026-10-03",
      "text": "China opposes using civilian drones for military purposes.",
      "is_quote": true,
      "signal": "policy_announcement",
      "stance": 0,
      "source_url": "https://www.mfa.gov.cn/eng/xw/fyrbt/lxjzh/202610/t20261003_12035482.html"
    },
    {
      "id": "st_32b2d8e3e0bb",
      "speaker": "Guo Jiakun",
      "role": "Foreign Ministry Spokesperson",
      "date": "2026-10-03",
      "text": "All parties should play a constructive role in facilitating a political settlement of the Ukraine crisis, instead of making groundless speculation and ill-intentioned association.",
      "is_quote": true,
      "signal": "accusation",
      "stance": 0,
      "source_url": "https://www.mfa.gov.cn/eng/xw/fyrbt/lxjzh/202610/t20261003_12035482.html"
    },
    {
      "id": "st_ca64984fd411",
      "speaker": "Guo Jiakun",
      "role": "Foreign Ministry Spokesperson",
      "date": "2026-10-03",
      "text": "The so-called “genocide” in Xinjiang is a blatant lie.",
      "is_quote": true,
      "signal": "denial",
      "stance": -1,
      "source_url": "https://www.mfa.gov.cn/eng/xw/fyrbt/lxjzh/202610/t20261003_12035482.html"
    },
    {
      "id": "st_ab33d2d5f48f",
      "speaker": "Guo Jiakun",
      "role": "Foreign Ministry Spokesperson",
      "date": "2026-10-03",
      "text": "This U.S. group is known for vilifying China out of political motives and has absolutely no credibility to speak of.",
      "is_quote": true,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://www.mfa.gov.cn/eng/xw/fyrbt/lxjzh/202610/t20261003_12035482.html"
    }
  ],
