  "statements": [
    {
      "id": "st_e15fb4c23474",
      "speaker": "Representative of Iran",
      "role": "Delegate to the Third Committee",
      "date": "2026-10-02",
      "text": "International humanitarian law does not become optional because the perpetrator sits on the Security Council,",
      "is_quote": true,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://press.un.org/en/2026/gashc4437.doc.htm"
    },
    {
      "id": "st_75e6c8950625",
      "speaker": "Representative of Iran",
      "role": "Delegate to the Third Committee",
      "date": "2026-10-02",
      "text": "Silence, Mr. Chair, is a position. Selective outrage is not a principle. It is complicity dressed as diplomacy.",
      "is_quote": true,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://press.un.org/en/2026/gashc4437.doc.htm"
    },
    {
      "id": "st_86596c18f445",
      "speaker": "Delegate of Iran",
      "role": "Delegate",
      "date": "2026-10-02",
      "text": "In right of reply, Iran said the UAE claim to the three islands is not grounded in facts, that the islands have always been integral parts of Iran's sovereign territory, and that official maps from hundreds of years ago support this.",
      "is_quote": false,
      "signal": "denial",
      "stance": -1,
      "source_url": "https://press.un.org/en/2026/gaspd833.doc.htm"
    }
  ],
