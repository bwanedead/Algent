  "statements": [
    {
      "id": "st_eba4bf4887bd",
      "speaker": "Alexander Stubb",
      "role": "President of the Republic of Finland",
      "date": "2026-10-07",
      "text": "We defend Europe's border together, in the north and in the south,",
      "is_quote": true,
      "signal": "commitment",
      "stance": 2,
      "source_url": "https://www.presidentti.fi/en/state-visit-to-finland-by-their-majesties-king-felipe-vi-and-queen-letizia-of-spain/"
    },
    {
      "id": "st_80199e437096",
      "speaker": "Alexander Stubb",
      "role": "President of the Republic of Finland",
      "date": "2026-10-06",
      "text": "Our societies are built on democracy, the rule of law, human rights and equality. We are both staunch supporters of multilateral cooperation and rules-based international order.",
      "is_quote": true,
      "signal": "commitment",
      "stance": 2,
      "source_url": "https://www.presidentti.fi/en/speech-by-president-of-the-republic-of-finland-alexander-stubb-at-the-state-banquet-at-the-presidential-palace-in-helsinki-on-the-occasion-of-the-state-visit-from-spain-on-6-october-2026/"
    },
    {
      "id": "st_418da0c123fc",
      "speaker": "Alexander Stubb",
      "role": "President of the Republic of Finland",
      "date": "2026-10-06",
      "text": "A Europe that remains united. A Europe that remains open. A Europe that remains capable of reform and ambitious for the future.",
      "is_quote": true,
      "signal": "commitment",
      "stance": 1,
      "source_url": "https://www.presidentti.fi/en/speech-by-president-of-the-republic-of-finland-alexander-stubb-at-the-state-banquet-at-the-presidential-palace-in-helsinki-on-the-occasion-of-the-state-visit-from-spain-on-6-october-2026/"
    },
    {
      "id": "st_6584d68004d3",
      "speaker": "Alexander Stubb",
      "role": "President of the Republic of Finland",
      "date": "2026-10-06",
      "text": "The events in Ceuta put Spain under immense pressure this summer. Finland has faced instrumentalized migration from Russia.",
      "is_quote": true,
      "signal": "accusation",
      "stance": -1,
      "source_url": "https://www.presidentti.fi/en/speech-by-president-of-the-republic-of-finland-alexander-stubb-at-the-state-banquet-at-the-presidential-palace-in-helsinki-on-the-occasion-of-the-state-visit-from-spain-on-6-october-2026/"
    },
    {
      "id": "st_0e3bb0241cee",
      "speaker": "Alexander Stubb",
      "role": "President of the Republic of Finland",
      "date": "2026-10-06",
      "text": "Secure external borders are essential. European solidarity is essential. And no Member State should ever be left alone when facing pressure that ultimately concerns all Europeans.",
      "is_quote": true,
      "signal": "policy_announcement",
      "stance": 1,
      "source_url": "https://www.presidentti.fi/en/speech-by-president-of-the-republic-of-finland-alexander-stubb-at-the-state-banquet-at-the-presidential-palace-in-helsinki-on-the-occasion-of-the-state-visit-from-spain-on-6-october-2026/"
    },
    {
      "id": "st_9a6fe42e8a20",
      "speaker": "Alexander Stubb",
      "role": "President of the Republic of Finland",
      "date": "2026-10-06",
      "text": "Finland stands in full solidarity with Spain.",
      "is_quote": true,
      "signal": "reassurance",
      "stance": 2,
      "source_url": "https://www.presidentti.fi/en/speech-by-president-of-the-republic-of-finland-alexander-stubb-at-the-state-banquet-at-the-presidential-palace-in-helsinki-on-the-occasion-of-the-state-visit-from-spain-on-6-october-2026/"
    },
    {
      "id": "st_eaf5e850492d",
      "speaker": "Alexander Stubb",
      "role": "President of the Republic of Finland",
      "date": "2026-10-06",
      "text": "Russia’s war of aggression against Ukraine continues to test Europe’s resilience and unity.",
      "is_quote": true,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://www.presidentti.fi/en/speech-by-president-of-the-republic-of-finland-alexander-stubb-at-the-state-banquet-at-the-presidential-palace-in-helsinki-on-the-occasion-of-the-state-visit-from-spain-on-6-october-2026/"
    },
    {
      "id": "st_d89e1dfb811c",
      "speaker": "Alexander Stubb",
      "role": "President of the Republic of Finland",
      "date": "2026-10-06",
      "text": "instability in the Middle East and migratory pressures affect us all, but most intimately the Southern Flank.",
      "is_quote": true,
      "signal": "other",
      "stance": 0,
      "source_url": "https://www.presidentti.fi/en/speech-by-president-of-the-republic-of-finland-alexander-stubb-at-the-state-banquet-at-the-presidential-palace-in-helsinki-on-the-occasion-of-the-state-visit-from-spain-on-6-october-2026/"
    }
  ],
