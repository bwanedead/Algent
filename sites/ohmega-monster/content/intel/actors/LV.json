  "statements": [
    {
      "id": "st_023eed9e64be",
      "speaker": "Edgars Rinkēvičs",
      "role": "President of Latvia",
      "date": "2026-10-05",
      "text": "Praised excellent relations between Latvia and Estonia and thanked Estonia for regular hands-on support in patrolling the Latvian-Belarusian border.",
      "is_quote": false,
      "signal": "reassurance",
      "stance": 2,
      "source_url": "https://www.president.lv/en/article/president-latvia-thanks-estonia-assistance-securing-latvian-belarusian-border"
    },
    {
      "id": "st_be326b44ca5d",
      "speaker": "Edgars Rinkēvičs",
      "role": "President of Latvia",
      "date": "2026-10-05",
      "text": "Expressed Latvia's solidarity with Estonia after recent acts of sabotage against Estonian defence industry company Milrem Robotics orchestrated by Russian secret services.",
      "is_quote": false,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://www.president.lv/en/article/president-latvia-thanks-estonia-assistance-securing-latvian-belarusian-border"
    },
    {
      "id": "st_43a35fa4eebd",
      "speaker": "Edgars Rinkēvičs",
      "role": "President of Latvia",
      "date": "2026-10-05",
      "text": "Said Russia uses these attacks and acts of sabotage to undermine support to Ukraine, cause confusion among people and test NATO.",
      "is_quote": false,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://www.president.lv/en/article/president-latvia-thanks-estonia-assistance-securing-latvian-belarusian-border"
    },
    {
      "id": "st_a88520f75725",
      "speaker": "Edgars Rinkēvičs",
      "role": "President of Latvia",
      "date": "2026-10-05",
      "text": "Believes there is no reason to adjust the military threat assessment and that a direct attack from Russia is currently very unlikely.",
      "is_quote": false,
      "signal": "other",
      "stance": 0,
      "source_url": "https://www.president.lv/en/article/president-latvia-thanks-estonia-assistance-securing-latvian-belarusian-border"
    },
    {
      "id": "st_49e3cbe2b04b",
      "speaker": "Edgars Rinkēvičs",
      "role": "President of Latvia",
      "date": "2026-10-05",
      "text": "Highlighted successful coordination of Baltic-Nordic cooperation (NB8 format) by Estonia, especially on regional security and Ukraine support agenda.",
      "is_quote": false,
      "signal": "other",
      "stance": 1,
      "source_url": "https://www.president.lv/en/article/president-latvia-thanks-estonia-assistance-securing-latvian-belarusian-border"
    },
    {
      "id": "st_0cbdc0f111d6",
      "speaker": "Edgars Rinkēvičs",
      "role": "President of Latvia",
      "date": "2026-10-05",
      "text": "President Rinkēvičs told Anduril Industries co-founder Palmer Luckey that Latvia offers infrastructure advantages for rapid testing of military technologies, in a discussion of global military technology trends and innovations.",
      "is_quote": false,
      "signal": "offer",
      "stance": 1,
      "source_url": "https://www.president.lv/en/article/president-latvia-highlights-readiness-latvian-companies-cooperate-field-defence-biomedicine-start-ups-and-film-industry-during-his-working-visit-us"
    },
    {
      "id": "st_8148626370a3",
      "speaker": "Edgars Rinkēvičs",
      "role": "President of Latvia",
      "date": "2026-10-05",
      "text": "Thank you, the United States, for your friendship! The United States is Latvia's strategic partner. Latvia seeks targeted cooperation with the US, which is why I am joined on this visit by representatives from the defence, film and biomedical sectors. We must continue our close cooperation and work together at both the political and business levels.",
      "is_quote": true,
      "signal": "reassurance",
      "stance": 2,
      "source_url": "https://www.president.lv/en/article/president-latvia-highlights-readiness-latvian-companies-cooperate-field-defence-biomedicine-start-ups-and-film-industry-during-his-working-visit-us"
    },
    {
      "id": "st_986d1043518d",
      "speaker": "Edgars Rinkēvičs",
      "role": "President of Latvia",
      "date": "2026-10-05",
      "text": "Latvia is a competitive place in Europe where a US company can cooperate with Latvian researchers and doctors in developing and testing new genomics solutions, while also making use of Latvia's connection to the wider European research area,",
      "is_quote": true,
      "signal": "offer",
      "stance": 1,
      "source_url": "https://www.president.lv/en/article/president-latvia-highlights-readiness-latvian-companies-cooperate-field-defence-biomedicine-start-ups-and-film-industry-during-his-working-visit-us"
    }
  ],
