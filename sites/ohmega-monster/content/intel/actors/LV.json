  "statements": [
    {
      "id": "st_d24b0cf5370f",
      "speaker": "Representative of Latvia",
      "role": "Representative to the First Committee",
      "date": "2026-10-09",
      "text": "Russia's illegal seizure and continued militarization of the Zaporizhzhia Nuclear Power Plant in Ukraine remains the most serious threat to nuclear safety and security and marks the first time in history a nuclear facility has been used for military purposes.",
      "is_quote": false,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://press.un.org/en/2026/gadis3766.doc.htm"
    },
    {
      "id": "st_5245ec76b9e4",
      "speaker": "Representative of Latvia",
      "role": "Representative to the First Committee",
      "date": "2026-10-09",
      "text": "Moscow has engaged in reckless and escalatory nuclear rhetoric, announced deployment of nuclear weapons in Belarus, revoked ratification of the Comprehensive Nuclear-Test-Ban Treaty and suspended implementation of New START.",
      "is_quote": false,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://press.un.org/en/2026/gadis3766.doc.htm"
    },
    {
      "id": "st_9a16928961bc",
      "speaker": "Baiba Braže",
      "role": "Minister of Foreign Affairs",
      "date": "2026-10-08",
      "text": "A greater US military presence and investment in Latvia is in the interest of both countries",
      "is_quote": true,
      "signal": "commitment",
      "stance": 2,
      "source_url": "https://www.mfa.gov.lv/en/article/baiba-braze-greater-us-military-presence-and-investment-latvia-interest-both-countries"
    },
    {
      "id": "st_a6dc77c35d04",
      "speaker": "Baiba Braže",
      "role": "Minister of Foreign Affairs",
      "date": "2026-10-08",
      "text": "US engagement in European security and a strong transatlantic partnership are essential prerequisites for a strong NATO",
      "is_quote": true,
      "signal": "reassurance",
      "stance": 2,
      "source_url": "https://www.mfa.gov.lv/en/article/baiba-braze-greater-us-military-presence-and-investment-latvia-interest-both-countries"
    },
    {
      "id": "st_1ffd324884fd",
      "speaker": "Baiba Braže",
      "role": "Minister of Foreign Affairs",
      "date": "2026-10-08",
      "text": "A greater US military presence in Latvia makes a practical contribution to the security of the entire region, whilst also strengthening US military readiness and technological capabilities",
      "is_quote": true,
      "signal": "commitment",
      "stance": 2,
      "source_url": "https://www.mfa.gov.lv/en/article/baiba-braze-greater-us-military-presence-and-investment-latvia-interest-both-countries"
    },
    {
      "id": "st_3a615c0452a8",
      "speaker": "Baiba Braže",
      "role": "Minister of Foreign Affairs",
      "date": "2026-10-08",
      "text": "Thanked the US Congress for its longstanding support for the security of Latvia and the Baltic states, highlighting the importance of the Baltic Security Initiative in strengthening the region's defence capabilities.",
      "is_quote": false,
      "signal": "reassurance",
      "stance": 2,
      "source_url": "https://www.mfa.gov.lv/en/article/baiba-braze-greater-us-military-presence-and-investment-latvia-interest-both-countries"
    },
    {
      "id": "st_c8257d0fa299",
      "speaker": "Baiba Braže",
      "role": "Minister of Foreign Affairs",
      "date": "2026-10-08",
      "text": "Flagged hybrid threats posed by Russia and Belarus, the instrumentalisation of illegal migration and strengthening of Latvia's eastern border, and the need to counter military cooperation between Russia and Iran.",
      "is_quote": false,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://www.mfa.gov.lv/en/article/baiba-braze-greater-us-military-presence-and-investment-latvia-interest-both-countries"
    },
    {
      "id": "st_72a1f939637b",
      "speaker": "Baiba Braže",
      "role": "Minister of Foreign Affairs",
      "date": "2026-10-08",
      "text": "need to maintain long-term military, political and economic support for Ukraine, whilst at the same time increasing sanctions pressure on Russia in order to achieve a just and lasting peace",
      "is_quote": true,
      "signal": "commitment",
      "stance": 1,
      "source_url": "https://www.mfa.gov.lv/en/article/baiba-braze-greater-us-military-presence-and-investment-latvia-interest-both-countries"
    }
  ],
