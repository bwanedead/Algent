  "timeline": [
    {
      "date": "2026-10-04",
      "headline": "Netanyahu orders security review of foreign flights to Israel",
      "detail": "On 4 October Netanyahu instructed NSC head Shmuel Ben Ezra to appoint an examiner for a thorough review of all security aspects of foreign civil aviation to Israel. Regev rejected ministry responsibility, saying oversight for foreign airlines falls to Mossad and Shin Bet; former Transport Ministry DG Keren Terner and others said responsibility lies with the ministry/Civil Aviation Authority. Lapid on 4 October dismissed the review as a 'sham investigation'.",
      "where": "Jerusalem, Israel",
      "verification": "researched",
      "sources": [
        "https://www.arabnews.com/middle-east/netanyahu-orders-security-review-of-international-flights-to-israel-after-flydubai-attack-3004607",
        "https://www.dawn.com/news/2034750"
      ],
      "from": "/geopolitics/2026-10-04"
    },
    {
      "date": "2026-10-04",
      "headline": "Australia opens counter-terrorism probe into co-pilot's student period in Melbourne",
      "detail": "On 4-5 October the Victorian Joint Counter Terrorism Team confirmed it is investigating the man's links to Australia. Sources said he held an Australian student visa issued 2014, studied in Melbourne (RMIT University cited) 2015-2017, left Australia, and had visa cancelled 2019 for non-enrolment. Early Israeli assessment per CBS sources on 4 October is likely lone-wolf, though all avenues remain open; CBS also reported FlyDubai hired him without vetting with the Omani government.",
      "where": "Melbourne, Australia",
      "verification": "researched",
      "sources": [
        "https://www.dawn.com/news/2034750/australia-probes-flydubai-co-pilots-links-to-the-country-police-say",
        "https://www.jpost.com/international/islamic-terrorism/article-910529",
        "https://www.cbsnews.com/news/flydubai-co-pilot-alleged-hijacking-lone-wolf/"
      ],
      "from": "/geopolitics/2026-10-04"
    },
    {
      "date": "2026-10-03",
      "headline": "UAE frames attack as attempted terrorist act; investigation continues",
      "detail": "On 3 October the UAE Attorney-General said investigations found the co-pilot attempted to commit a terrorist act, attacking Captain Smit Machchhar with a crash axe and attempting to take control of the aircraft. Investigations continue into motives, links and technical/digital evidence. Multiple reports, graded likely, identify the co-pilot as 29-year-old Omani Hamam al-Hammami and say Oman had previously removed him from flying duties over radical views.",
      "where": "Abu Dhabi, United Arab Emirates",
      "verification": "researched",
      "sources": [
        "https://www.chinadaily.com.cn/a/202610/03/WS6ac0b21ce4b06d4aa05614d4.html",
        "https://www.france24.com/en/middle-east/20261003-co-pilot-on-flydubai-flight-was-banned-from-flying-by-oman-for-holding-extremist-views",
        "https://www.dw.com/en/co-pilot-on-flydubai-flight-was-banned-from-flying-by-oman/a-79526641",
        "https://www.cbsnews.com/news/flydubai-co-pilot-alleged-hijacking-lone-wolf/"
      ],
      "from": "/geopolitics/2026-10-04"
    },
    {
      "date": "2026-10-02",
      "headline": "Co-pilot transferred from Saudi detention to UAE custody for joint interrogation",
      "detail": "The co-pilot was detained by Saudi authorities at Tabuk after the 30 September landing and transferred to UAE custody on 2 October, where interrogation is underway with Israeli representatives participating. Both pilots were hospitalized in Tabuk; Captain Machchhar was reported stable and later transferred to Abu Dhabi.",
      "where": "Tabuk, Saudi Arabia",
      "verification": "researched",
      "sources": [
        "https://www.cbsnews.com/news/flydubai-co-pilot-alleged-hijacking-lone-wolf/",
        "https://www.dawn.com/news/2034750",
        "https://www.bbc.com/news/articles/cqjdv7pmj9dno"
      ],
      "from": "/geopolitics/2026-10-04"
    },
    {
      "date": "2026-09-30",
      "headline": "FlyDubai Tel Aviv route suspended; Israel to tighten pilot checks",
      "detail": "FlyDubai suspended flights to/from Tel Aviv on 30 September at authorities' request/recommendation of Shin Bet pending investigation; CEO Ghaith Al Ghaith said suspension allows authorities to establish facts. Israeli officials said they will ramp up checks requiring identity verification and security checks for every pilot on Israel-bound flights.",
      "where": "Tel Aviv, Israel",
      "verification": "researched",
      "sources": [
        "https://www.flightradar24.com/blog/flight-tracking-news/major-incident/flydubai-flight-to-tel-aviv-diverts-to-tabuk-amid-onboard-incident",
        "https://www.jpost.com/middle-east/article-910234",
        "https://www.bbc.com/news/articles/cqjdv7pmj9dno"
      ],
      "from": "/geopolitics/2026-10-04"
    },
    {
      "date": "2026-09-30",
      "headline": "Co-pilot axe attack triggers emergency descent and hijack squawk; crew and passengers retake cockpit and divert to Tabuk",
      "detail": "FlyDubai FZ1073 departed Dubai 03:05 GMT 30 September for Tel Aviv with about 172 aboard (174 per UAE/Israeli statements). Around 05:21 GMT over Saudi Arabia near the Jordanian border the 737 MAX entered a steep descent of ~14,000-17,000 ft in under 2 minutes, squawked 7700 at ~05:28, then 7500 (hijacking) at ~05:35 while briefly entering Jordanian airspace before returning to Saudi Arabia. Inside the cockpit the co-pilot attacked Machchhar with a crash axe and tried to seize controls. Despite stab injuries Machchhar opened the reinforced door, allowing passengers and crew, including two FlyDubai pilots travelling as passengers, to subdue the attacker. The aircraft landed safely at Tabuk ~06:45-06:58 GMT.",
      "where": "over Saudi Arabia to Tabuk, Saudi Arabia",
      "verification": "researched",
      "sources": [
        "https://www.bbc.com/news/articles/cqjdv7pmj9dno",
        "https://www.flightradar24.com/blog/flight-tracking-news/major-incident/flydubai-flight-to-tel-aviv-diverts-to-tabuk-amid-onboard-incident",
        "https://www.aljazeera.com/news/2026/9/30/flydubai-fz1073-timeline-how-the-israel-bound-flight-emergency-unfolded",
        "https://www.chinadaily.com.cn/a/202610/03/WS6ac0b21ce4b06d4aa05614d4.html",
        "https://www.cbsnews.com/news/flydubai-co-pilot-alleged-hijacking-lone-wolf/"
      ],
      "from": "/geopolitics/2026-10-04"
    }
