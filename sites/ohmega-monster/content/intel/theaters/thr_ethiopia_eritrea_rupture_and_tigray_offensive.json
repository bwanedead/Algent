  "timeline": [
    {
      "date": "2026-10-03",
      "headline": "Federal forces retake Mekelle airport as TPLF pulls back from city",
      "detail": "On Oct 3 Ethiopian National Defence Forces and allied fighters regained control of Alula Aba Nega Airport about 10km east of Mekelle city centre. TPLF fighters and leaders were observed leaving Mekelle, with government offices and police stations left without security personnel and reports of looting of government facilities. Telecom/internet blackout and restricted media access make independent verification difficult.",
      "where": "Mekelle, Tigray",
      "verification": "researched",
      "sources": [
        "https://www.aljazeera.com/news/2026/10/3/rebels-pulling-back-as-addis-ababas-forces-advance-reports-say",
        "https://www.aljazeera.com/news/2026/10/3/ethiopian-govt-forces-advance-in-tigray-as-rebels-retreat-what-to-know"
      ],
      "from": "/geopolitics/2026-10-03"
    },
    {
      "date": "2026-10-01",
      "headline": "Explosions hit Addis Ababa amid drone ban and widening Egypt-Ethiopia expulsions",
      "detail": "Overnight Oct 1-2 explosions were heard in Addis Ababa near military headquarters in the west and intelligence headquarters in the south. A source linked to the opposition alliance claimed it carried out drone strikes on the capital, including the military headquarters (unconfirmed). On Oct 1 Ethiopia's National Intelligence and Security Service imposed an indefinite ban on drone flights over Addis Ababa and surroundings. Separately, Ethiopia declared Egyptian diplomat Ahmed Moharam Ahmed Soliman persona non grata Oct 1 (48 hours to leave) and Egypt expelled an Ethiopian embassy counsellor in Cairo Oct 2 in reciprocal move. Ethiopia accuses Eritrea, Sudan and Egypt of backing the rebel alliance; all deny.",
      "where": "Addis Ababa and Cairo",
      "verification": "researched",
      "sources": [
        "https://www.bbc.com/news/articles/crpd0d0jl0y0o",
        "https://www.aljazeera.com/news/2026/10/1/eritrea-severs-diplomatic-ties-with-ethiopia-in-tit-for-tat-move",
        "https://www.aljazeera.com/news/2026/10/3/ethiopian-govt-forces-advance-in-tigray-as-rebels-retreat-what-to-know"
      ],
      "from": "/geopolitics/2026-10-03"
    },
    {
      "date": "2026-10-01",
      "headline": "Ethiopia and Eritrea sever all diplomatic ties in tit-for-tat moves",
      "detail": "On Oct 1 Ethiopia announced closure of its embassy in Asmara and declared 10 Eritrean diplomats in Addis Ababa persona non grata to leave within 48 hours for activities posing a direct threat to national security in breach of Vienna Convention. Late Oct 1 Eritrea's Ministry of Foreign Affairs said it was severing all diplomatic ties with Ethiopia, saying it had 'no option but to reciprocate in kind' with 'negative corollaries'.",
      "where": "Asmara and Addis Ababa",
      "verification": "researched",
      "sources": [
        "https://www.aljazeera.com/news/2026/10/1/eritrea-severs-diplomatic-ties-with-ethiopia-in-tit-for-tat-move",
