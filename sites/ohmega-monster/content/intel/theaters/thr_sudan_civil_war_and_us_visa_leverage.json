  "timeline": [
    {
      "date": "2026-10-04",
      "headline": "Airstrike hits WFP truck in South Kordofan, killing driver",
      "detail": "On Oct 4, WFP reported an airstrike on a UN truck in South Kordofan state killed the driver. Reporting did not attribute the strike to a specific belligerent and provided no further casualty details.",
      "where": "South Kordofan, Sudan",
      "verification": "reported",
      "sources": [
        "https://www.aljazeera.com/news/2026/10/4/air-strike-in-sudan-kills-un-aid-truck-driver-wfp"
      ],
      "from": "/geopolitics/2026-10-04"
    },
    {
      "date": "2026-10-02",
      "headline": "UK at UN blames external weapons flows for sustaining Sudan war",
      "detail": "On Oct 2 at the UN Third Committee, UK Permanent Representative Sarah MacIntosh said the illegal flow of weapons and external support is sustaining the Sudan conflict and demanded all states stop supporting warring parties, respect international humanitarian law, and use influence to protect civilians and secure humanitarian access.",
      "where": "United Nations, New York",
      "verification": "researched",
      "sources": [
        "https://www.gov.uk/government/speeches/the-uk-will-defend-universal-rights-without-fear-or-favour-uk-statement-at-the-un-third-committee"
      ],
      "from": "/geopolitics/2026-10-04"
    },
    {
      "date": "2026-10-02",
      "headline": "SAF says it recaptured al-Mazroub in North Kordofan",
      "detail": "On Oct 2, Sudan's armed forces announced they had recaptured the North Kordofan town of al-Mazroub, described as an RSF stronghold. Single-source report; no independent confirmation in evidence provided.",
      "where": "al-Mazroub, North Kordofan, Sudan",
      "verification": "reported",
      "sources": [
        "https://www.aljazeera.com/news/2026/10/2/sudans-army-says-it-captured-rsf-stronghold-in-north-kordofan"
      ],
      "from": "/geopolitics/2026-10-04"
    },
    {
      "date": "2026-10-01",
      "headline": "RSF drone strike hits University of Kordofan dormitory in El Obeid",
      "detail": "On Oct 1, a drone strike hit student housing of the University of Kordofan in El Obeid, North Kordofan. Researched confirmation: 5 civilians killed and 47 wounded. One outlet later reported Oct 2 that the death toll had risen to 10 (single source, unverified). RSF attributed as attacker in initial reporting.",
      "where": "El Obeid, North Kordofan, Sudan",
      "verification": "researched",
