  "statements": [
    {
      "id": "st_28cf0f429875",
      "speaker": "Gitanas Nausėda",
      "role": "President",
      "date": "2026-10-02",
      "text": "Nausėda told media he had highlighted to Trump Lithuania's decision to spend more than 5 percent of GDP on defence and a 10-year agreement for purchase of US liquefied natural gas",
      "is_quote": false,
      "signal": "policy_announcement",
      "stance": 1,
      "source_url": "https://www.delfi.lt/en/politics/nauseda-thanks-trump-for-sending-us-troops-to-lithuania-120313472"
    },
    {
      "id": "st_c0e5ca9d5e2a",
      "speaker": "Gitanas Nausėda",
      "role": "President",
      "date": "2026-09-22",
      "text": "Mr President, I thank you for sending US troops to Lithuania and for strengthening our energy partnership – the supply of US liquefied natural gas to Lithuania. Cooperation between the United States and Lithuania is particularly important to us,",
      "is_quote": true,
      "signal": "other",
      "stance": 2,
      "source_url": "https://www.delfi.lt/en/politics/nauseda-thanks-trump-for-sending-us-troops-to-lithuania-120313472"
    },
    {
      "id": "st_3aac82bb5616",
      "speaker": "Gitanas Nausėda",
      "role": "President",
      "date": "2026-09-22",
      "text": "Nausėda said Lithuania was ready to further strengthen the transatlantic bond and Lithuanian-US cooperation in defence and energy",
      "is_quote": false,
      "signal": "commitment",
      "stance": 2,
      "source_url": "https://www.delfi.lt/en/politics/nauseda-thanks-trump-for-sending-us-troops-to-lithuania-120313472"
    }
  ],
