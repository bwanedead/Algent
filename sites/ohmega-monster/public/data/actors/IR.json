  "statements": [
    {
      "id": "st_36b5da6fa3f6",
      "speaker": "Esmail Baghaei",
      "role": "Foreign Ministry Spokesman",
      "date": "2026-10-05",
      "text": "“structural nihilism”",
      "is_quote": true,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://en.mfa.ir/portal/NewsView/795355"
    },
    {
      "id": "st_43c0778f4ee0",
      "speaker": "Esmail Baghaei",
      "role": "Foreign Ministry Spokesman",
      "date": "2026-10-05",
      "text": "\"In the end we all die anyway, so it doesn't matter.\"",
      "is_quote": true,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://en.mfa.ir/portal/NewsView/795355"
    },
    {
      "id": "st_43ae4d86ef9a",
      "speaker": "Esmail Baghaei",
      "role": "Foreign Ministry Spokesman",
      "date": "2026-10-05",
      "text": "“We all die” is a fact; “so it doesn't matter” is the leap where existential dread becomes a political weapon.",
      "is_quote": true,
      "signal": "warning",
      "stance": -2,
      "source_url": "https://en.mfa.ir/portal/NewsView/795355"
    },
    {
      "id": "st_17fce35f4d6e",
      "speaker": "Esmail Baghaei",
      "role": "Foreign Ministry Spokesman",
      "date": "2026-10-05",
      "text": "Appeasement buys no safety - it merely negotiates the order of the victims.",
      "is_quote": true,
      "signal": "warning",
      "stance": -2,
      "source_url": "https://en.mfa.ir/portal/NewsView/795355"
    },
    {
      "id": "st_23ffe77b59ab",
      "speaker": "Esmail Baghaei",
      "role": "Foreign Ministry Spokesperson",
      "date": "2026-10-05",
      "text": "condemned the violent treatment of protesters by French security forces and called on those whose human rights claims have become deafening to respect fundamental human rights and basic freedoms when dealing with labor-related protests by school and university students",
      "is_quote": true,
      "signal": "accusation",
      "stance": -1,
      "source_url": "https://en.mfa.ir/portal/NewsView/795379"
    },
    {
      "id": "st_02012831c274",
      "speaker": "Esmail Baghaei",
      "role": "Foreign Ministry Spokesperson",
      "date": "2026-10-05",
      "text": "French officials who describe the treatment of armed terrorists trained by the Israeli regime by Iranian security forces as a violation of human rights, themselves tolerate not the slightest violent act at peaceful gatherings against the police and suppress protesters in the harshest manner",
      "is_quote": true,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://en.mfa.ir/portal/NewsView/795379"
    },
    {
      "id": "st_ac3d9d7e7425",
      "speaker": "Esmail Baghaei",
      "role": "Foreign Ministry Spokesperson",
      "date": "2026-10-05",
      "text": "stressed the need for protesters to refrain from violent behavior and causing damage to public and private property, as well as from attacking security and law enforcement personnel",
      "is_quote": true,
      "signal": "other",
      "stance": 0,
      "source_url": "https://en.mfa.ir/portal/NewsView/795379"
    },
    {
      "id": "st_40a7dd94976f",
      "speaker": "Esmail Baghaei",
      "role": "Foreign Ministry Spokesperson",
      "date": "2026-10-05",
      "text": "called for investigation into allegations that security forces had used severe violence against protesters",
      "is_quote": true,
      "signal": "demand",
      "stance": -1,
      "source_url": "https://en.mfa.ir/portal/NewsView/795379"
    }
  ],
