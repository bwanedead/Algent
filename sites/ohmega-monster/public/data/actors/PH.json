  "statements": [
    {
      "id": "st_252255b3358f",
      "speaker": "Presidential Communications Office",
      "role": "Presidential Communications Office",
      "date": "2026-10-04",
      "text": "Philippine President Ferdinand Marcos and Polish President Karol Nawrocki are expected to discuss regional and international issues of common interest during the state visit.",
      "is_quote": false,
      "signal": "other",
      "stance": 1,
      "source_url": "https://www.gmanetwork.com/news/topstories/nation/1004679/polish-president-karol-nawrocki-to-visit-ph-from-oct-5-to-8/story/"
    },
    {
      "id": "st_97810ad4fdac",
      "speaker": "Presidential Communications Office",
      "role": "Presidential Communications Office",
      "date": "2026-10-04",
      "text": "The visit is expected to open more opportunities for cooperation between the two countries in key areas, including defense and security, trade and investment, agriculture, science and technology, information and communications technology, legal cooperation, tourism, and people-to-people exchanges,",
      "is_quote": true,
      "signal": "policy_announcement",
      "stance": 2,
      "source_url": "https://www.gmanetwork.com/news/topstories/nation/1004679/polish-president-karol-nawrocki-to-visit-ph-from-oct-5-to-8/story/"
    },
    {
      "id": "st_cf234273f299",
      "speaker": "Presidential Communications Office",
      "role": "Presidential Communications Office",
      "date": "2026-10-04",
      "text": "Poland formally acceded to the Treaty of Amity and Cooperation alongside Lithuania, Romania and Sweden during the 50th anniversary of the TAC hosted by the Philippines during its 2026 ASEAN Chairship in Manila.",
      "is_quote": false,
      "signal": "policy_announcement",
      "stance": 1,
      "source_url": "https://www.gmanetwork.com/news/topstories/nation/1004679/polish-president-karol-nawrocki-to-visit-ph-from-oct-5-to-8/story/"
    }
  ],
