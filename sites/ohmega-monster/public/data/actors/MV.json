  "statements": [
    {
      "id": "st_37b5649060e5",
      "speaker": "Representative of Maldives",
      "role": "Representative",
      "date": "2026-10-08",
      "text": "For delegations with small legal teams, timely access to existing practice can make the difference between being able to contribute and remaining silent.",
      "is_quote": true,
      "signal": "demand",
      "stance": 0,
      "source_url": "https://press.un.org/en/2026/gal3745.doc.htm"
    },
    {
      "id": "st_273634752b9c",
      "speaker": "Ali Naseer Mohamed",
      "role": "Ambassador of the Maldives",
      "date": "2026-10-08",
      "text": "This means that every reform should be tested against a simple question: does it widen the practical ability of all Member States, especially small delegations, to participate meaningfully?",
      "is_quote": true,
      "signal": "demand",
      "stance": 0,
      "source_url": "https://press.un.org/en/2026/ga12793.doc.htm"
    }
  ],
