  "statements": [
    {
      "id": "st_064969fd279f",
      "speaker": "Germany delegate",
      "role": "Delegate to the UN",
      "date": "2026-10-09",
      "text": "As Europeans, we stand ready to talk. Ukraine stands ready to talk. A negotiated peace is possible",
      "is_quote": true,
      "signal": "offer",
      "stance": -1,
      "source_url": "https://press.un.org/en/2026/sc16472.doc.htm"
    },
    {
      "id": "st_f92a9822b4f1",
      "speaker": "Johann Wadephul",
      "role": "Foreign Minister",
      "date": "2026-10-09",
      "text": "one of the world’s largest free trade zones, with more than 715 million people",
      "is_quote": true,
      "signal": "policy_announcement",
      "stance": 2,
      "source_url": "https://www.auswaertiges-amt.de/en/newsroom/news/2805150-2805150"
    },
    {
      "id": "st_3a6a927d7cf0",
      "speaker": "Johann Wadephul",
      "role": "Foreign Minister",
      "date": "2026-10-09",
      "text": "The trade pillar has been applied provisionally for just over 150 days now, and it has brought very tangible simplifications for our businesses. We are seeing tariffs falling. We are finding better access to public procurement and service markets in Latin America.",
      "is_quote": true,
      "signal": "policy_announcement",
      "stance": 2,
      "source_url": "https://www.auswaertiges-amt.de/en/newsroom/news/2805150-2805150"
    },
    {
      "id": "st_20ac1299d5f3",
      "speaker": "Johann Wadephul",
      "role": "Foreign Minister",
      "date": "2026-10-09",
      "text": "We are committed to free trade!",
      "is_quote": true,
      "signal": "commitment",
      "stance": 1,
      "source_url": "https://www.auswaertiges-amt.de/en/newsroom/news/2805150-2805150"
    },
    {
      "id": "st_ce0d2b5b7cf4",
      "speaker": "Johann Wadephul",
      "role": "Foreign Minister",
      "date": "2026-10-09",
      "text": "The EU-Mercosur Agreement is forecast to increase the European Union’s GDP by more than 77 billion euro.",
      "is_quote": true,
      "signal": "policy_announcement",
      "stance": 2,
      "source_url": "https://www.auswaertiges-amt.de/en/newsroom/news/2805150-2805150"
    },
    {
      "id": "st_60d3fb3b6f92",
      "speaker": "Johann Wadephul",
      "role": "Foreign Minister",
      "date": "2026-10-09",
      "text": "This economic milestone is also an important political signal, a sign that we, as democracies worldwide, stand together and are committed to rules-based trade",
      "is_quote": true,
      "signal": "reassurance",
      "stance": 2,
      "source_url": "https://www.auswaertiges-amt.de/en/newsroom/news/2805150-2805150"
    },
    {
      "id": "st_62dcf46c64e5",
      "speaker": "Johann Wadephul",
      "role": "Foreign Minister",
      "date": "2026-10-09",
      "text": "if we are to be able to assert ourselves on the world stage at all, then we have to bring our full European weight to bear.",
      "is_quote": true,
      "signal": "commitment",
      "stance": 1,
      "source_url": "https://www.auswaertiges-amt.de/en/newsroom/news/2805150-2805150"
    },
    {
      "id": "st_5058bf0bb541",
      "speaker": "Johann Wadephul",
      "role": "Foreign Minister",
      "date": "2026-10-09",
      "text": "the Federal Government is firmly convinced that the Agreement is in conformity with the EU Treaties.",
      "is_quote": true,
      "signal": "reassurance",
      "stance": 1,
      "source_url": "https://www.auswaertiges-amt.de/en/newsroom/news/2805150-2805150"
    }
  ],
