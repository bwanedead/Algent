  "statements": [
    {
      "id": "st_d108082f1e26",
      "speaker": "Emmanuel Macron",
      "role": "President of the Republic",
      "date": "2026-10-02",
      "text": "This unity within the G7 sends a clear signal to the markets to bring down energy prices.",
      "is_quote": true,
      "signal": "reassurance",
      "stance": 1,
      "source_url": "https://www.elysee.fr/emmanuel-macron/2026/10/02/videoconference-with-g7-leaders-on-the-global-energy-situation"
    },
    {
      "id": "st_955428662ad7",
      "speaker": "President of the French Republic",
      "role": "President of the French Republic",
      "date": "2026-10-01",
      "text": "to establish the concept of forward deterrence",
      "is_quote": true,
      "signal": "policy_announcement",
      "stance": 1,
      "source_url": "https://www.elysee.fr/emmanuel-macron/2026/10/01/france-and-belgium-held-their-first-nuclear-steering-group-meeting-in-paris"
    },
    {
      "id": "st_867da8877eda",
      "speaker": "Emmanuel Macron",
      "role": "President of the Republic",
      "date": "2026-09-28",
      "text": "C'est précisément le sens de notre engagement indéfectible aux côtés de l'Ukraine, face à l'agression militaire de la Russie et aux côtés du droit international, en bâtissant une Europe de la défense et de la paix.",
      "is_quote": true,
      "signal": "commitment",
      "stance": 1,
      "source_url": "https://www.elysee.fr/emmanuel-macron/2026/09/28/allocutions-a-metz-aux-racines-de-leurope-pour-la-paix-et-lunite"
    },
    {
      "id": "st_dbaa5b13f632",
      "speaker": "Emmanuel Macron",
      "role": "President of the Republic",
      "date": "2026-09-28",
      "text": "la guerre est revenue sur notre continent et notre Europe est bousculée par le retour des empires.",
      "is_quote": true,
      "signal": "warning",
      "stance": -1,
      "source_url": "https://www.elysee.fr/emmanuel-macron/2026/09/28/allocutions-a-metz-aux-racines-de-leurope-pour-la-paix-et-lunite"
    },
    {
      "id": "st_27ff776fe801",
      "speaker": "Emmanuel Macron",
      "role": "President of the Republic",
      "date": "2026-09-28",
      "text": "D'autres veulent encore aujourd'hui nous rejoindre, des Balkans jusqu'à l'Ukraine",
      "is_quote": true,
      "signal": "commitment",
      "stance": 2,
      "source_url": "https://www.elysee.fr/emmanuel-macron/2026/09/28/allocutions-a-metz-aux-racines-de-leurope-pour-la-paix-et-lunite"
    },
    {
      "id": "st_f9434c5e17f5",
      "speaker": "Emmanuel Macron",
      "role": "President of the Republic",
      "date": "2026-09-28",
      "text": "Pour assurer une souveraineté réelle, il nous faut donc agir. Agir d'abord pour assurer notre sécurité et préserver nos valeurs, car la paix ne se décrète pas, elle se construit patiemment par des artisans de bonne volonté, lucides et constants.",
      "is_quote": true,
      "signal": "policy_announcement",
      "stance": 1,
      "source_url": "https://www.elysee.fr/emmanuel-macron/2026/09/28/allocutions-a-metz-aux-racines-de-leurope-pour-la-paix-et-lunite"
    },
    {
      "id": "st_d3317b429920",
      "speaker": "Emmanuel Macron",
      "role": "President of the Republic",
      "date": "2026-09-28",
      "text": "Agir pour nous protéger contre l'épidémie de désinformation et d'ingérence qui veulent saper nos démocraties et nous diviser, porter atteinte aux projets européens.",
      "is_quote": true,
      "signal": "warning",
      "stance": -1,
      "source_url": "https://www.elysee.fr/emmanuel-macron/2026/09/28/allocutions-a-metz-aux-racines-de-leurope-pour-la-paix-et-lunite"
    },
    {
      "id": "st_3fe876c371c5",
      "speaker": "Presidency of France",
      "role": "President of the Republic",
      "date": "2026-09-25",
      "text": "The apostolic visit forms part of the traditional relations between France and the Holy See and bears witness to the depth of a dialogue based on shared values and commitments.",
      "is_quote": false,
      "signal": "reassurance",
      "stance": 2,
      "source_url": "https://www.elysee.fr/emmanuel-macron/2026/09/25/pope-leo-xivs-apostolic-journey-to-france"
    }
  ],
