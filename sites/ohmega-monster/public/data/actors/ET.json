  "statements": [
    {
      "id": "st_540185a51353",
      "speaker": "Gedion Timothewos",
      "role": "Foreign Minister",
      "date": "2026-10-09",
      "text": "a blatant act of aggression that engages Ethiopia's inherent right to self-defence",
      "is_quote": true,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://www.france24.com/en/africa/20261009-eritrea-ethiopia-accuse-each-other-of-provoking-war-as-tigray-rebels-retreat"
    },
    {
      "id": "st_1c1411fee7cf",
      "speaker": "Abiy Ahmed",
      "role": "Prime Minister",
      "date": "2026-10-09",
      "text": "Prime Minister Abiy Ahmed stated that access to the sea was a priority upon being sworn in for another five-year term.",
      "is_quote": false,
      "signal": "policy_announcement",
      "stance": -1,
      "source_url": "https://www.dw.com/en/eritrean-troops-in-ethiopia-raise-fears-of-a-regional-war/a-79615065?maca=en-rss-en-all-1573-rdf"
    },
    {
      "id": "st_ef295bb572ca",
      "speaker": "Gedion Timothewos",
      "role": "Foreign Minister",
      "date": "2026-10-08",
      "text": "Ethiopia called for the immediate withdrawal of Eritrean troops from its territory in a letter to the UN Security Council.",
      "is_quote": false,
      "signal": "demand",
      "stance": -1,
      "source_url": "https://www.dw.com/en/eritrean-troops-in-ethiopia-raise-fears-of-a-regional-war/a-79615065?maca=en-rss-en-all-1573-rdf"
    },
    {
      "id": "st_eed4c13a5a49",
      "speaker": "Gedion Timothewos",
      "role": "Foreign Minister",
      "date": "2026-10-08",
      "text": "no option but to defend itself against Eritrea",
      "is_quote": true,
      "signal": "threat",
      "stance": -2,
      "source_url": "https://www.dw.com/en/eritrean-troops-in-ethiopia-raise-fears-of-a-regional-war/a-79615065?maca=en-rss-en-all-1573-rdf"
    },
    {
      "id": "st_603177fa86a9",
      "speaker": "Ethiopia",
      "role": "Government",
      "date": "2026-10-05",
      "text": "Eritrea is directly backing the Tigray rebels, with added support from Sudan and Egypt.",
      "is_quote": false,
      "signal": "accusation",
      "stance": -2,
      "source_url": "http://www.africanews.com/2026/10/05/ethiopias-federal-forces-retake-tigrayan-capital-mekelle/"
    },
    {
      "id": "st_057a323393d3",
      "speaker": "Ethiopia",
      "role": "Government",
      "date": "2026-10-04",
      "text": "Ethiopia accuses Eritrea and Egypt of supporting the Tigrayan rebels (TPLF).",
      "is_quote": false,
      "signal": "accusation",
      "stance": -2,
      "source_url": "http://www.africanews.com/2026/10/04/ethiopias-oromo-celebrate-irreecha-and-call-for-peace-as-federal-forces-enter-mekelle/"
    },
    {
      "id": "st_69fbc131a533",
      "speaker": "Ethiopian authorities",
      "role": "",
      "date": "2026-10-04",
      "text": "Ethiopian authorities accused the TPLF of allying with neighbouring Eritrea and with Ethiopian armed groups.",
      "is_quote": false,
      "signal": "accusation",
      "stance": -2,
      "source_url": "http://www.africanews.com/2026/10/04/ethiopian-forces-recapture-mekelle-airport-from-tigrayan-fighters/"
    },
    {
      "id": "st_a2a485fb1045",
      "speaker": "Ethiopian general",
      "role": "General",
      "date": "2026-10-03",
      "text": "The military is in full control of the airport. That much I can confirm,",
      "is_quote": true,
      "signal": "other",
      "stance": -1,
      "source_url": "http://www.africanews.com/2026/10/04/ethiopian-forces-recapture-mekelle-airport-from-tigrayan-fighters/"
    }
  ],
