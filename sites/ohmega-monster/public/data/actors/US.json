  "statements": [
    {
      "id": "st_2a8e1879850d",
      "speaker": "Donald Trump",
      "role": "President",
      "date": "2026-10-10",
      "text": "The US campaign to dismantle the ICC was intended to defend Netanyahu and others from prosecution.",
      "is_quote": false,
      "signal": "policy_announcement",
      "stance": -2,
      "source_url": "https://www.middleeasteye.net/live-blog/live-blog-update/trump-says-icc-sanctions-aimed-defending-netanyahu-and-others"
    },
    {
      "id": "st_ad7c78dcbaf6",
      "speaker": "Donald J. Trump",
      "role": "President of the United States",
      "date": "2026-10-09",
      "text": "we build upon our extraordinary relationships with our Nordic partners and open a glorious new chapter in America’s Arctic story",
      "is_quote": true,
      "signal": "reassurance",
      "stance": 2,
      "source_url": "https://www.whitehouse.gov/briefings-statements/2026/10/presidential-message-on-leif-erikson-day/"
    },
    {
      "id": "st_e8658091fae5",
      "speaker": "Donald J. Trump",
      "role": "President of the United States",
      "date": "2026-10-09",
      "text": "my Administration has now secured Greenland’s future as a bastion for U.S. security and transatlantic defense",
      "is_quote": true,
      "signal": "commitment",
      "stance": 1,
      "source_url": "https://www.whitehouse.gov/briefings-statements/2026/10/presidential-message-on-leif-erikson-day/"
    },
    {
      "id": "st_ee5f532412bd",
      "speaker": "Donald J. Trump",
      "role": "President of the United States",
      "date": "2026-10-09",
      "text": "Last month, I entered into a historic agreement with Denmark and Greenland that gives the United States permanent control over security in Greenland, guaranteeing our ability to safeguard America and our allies for all time",
      "is_quote": true,
      "signal": "policy_announcement",
      "stance": 1,
      "source_url": "https://www.whitehouse.gov/briefings-statements/2026/10/presidential-message-on-leif-erikson-day/"
    },
    {
      "id": "st_35a6cbb8c0e1",
      "speaker": "Donald J. Trump",
      "role": "President of the United States",
      "date": "2026-10-09",
      "text": "I permanently recognized Greenland as an essential national security partner and made the Arctic a pillar of American strength once again",
      "is_quote": true,
      "signal": "policy_announcement",
      "stance": 1,
      "source_url": "https://www.whitehouse.gov/briefings-statements/2026/10/presidential-message-on-leif-erikson-day/"
    },
    {
      "id": "st_5603302853ec",
      "speaker": "Donald Trump",
      "role": "President",
      "date": "2026-10-09",
      "text": "Russia agreed to deliver more than 300,000 tonnes of diesel to American and global markets",
      "is_quote": false,
      "signal": "policy_announcement",
      "stance": 1,
      "source_url": "https://www.aljazeera.com/news/2026/10/10/putin-tells-trump-peace-talks-are-unlikely-cites-ukraine-drone-attacks"
    },
    {
      "id": "st_1829713d2440",
      "speaker": "Donald Trump",
      "role": "President",
      "date": "2026-10-09",
      "text": "Announced an agreement with Russian President Vladimir Putin, made during a phone call that was supposed to be about a suspected plague outbreak in Russia, for the release of Russian diesel to global markets.",
      "is_quote": false,
      "signal": "policy_announcement",
      "stance": 2,
      "source_url": "https://www.dw.com/en/trump-putin-agree-on-deal-to-release-russian-diesel-to-us-world-markets/a-79623364?maca=en-rss-en-all-1573-rdf"
    },
    {
      "id": "st_80bbb20cf0de",
      "speaker": "Donald Trump",
      "role": "President",
      "date": "2026-10-09",
      "text": "immediately thereafter",
