  "statements": [
    {
      "id": "st_eb5df750b65c",
      "speaker": "Marco Rubio",
      "role": "Secretary of State",
      "date": "2026-10-04",
      "text": "The United States remains committed to strengthening our commercial ties through strategic investments such as Convalt Energy’s $6.2 billion hydropower and data center project while also building on the close cooperation we share in health and security.",
      "is_quote": true,
      "signal": "commitment",
      "stance": 1,
      "source_url": "https://www.state.gov/releases/office-of-the-spokesman/2026/10/lesotho-national-day-2/"
    },
    {
      "id": "st_c33eb76690b6",
      "speaker": "White House",
      "role": "White House",
      "date": "2026-10-04",
      "text": "The United States and 16 other countries jointly endorsed the Kyoto Vision for a Golden Age of Science at the STS Forum in Kyoto, reflecting a shared ambition to renew science ecosystems and usher in a golden age of discovery, including pledges to harness super intelligence for science, improve institutions of discovery, and cultivate talent.",
      "is_quote": false,
      "signal": "commitment",
      "stance": 1,
      "source_url": "https://www.whitehouse.gov/releases/2026/10/us-leads-international-coalition-to-endorse-kyoto-vision-for-a-golden-age-of-science/"
    },
    {
      "id": "st_ec4710157911",
      "speaker": "Michael Kratsios",
      "role": "Director, White House Office of Science and Technology Policy",
      "date": "2026-10-04",
      "text": "Super intelligence applied to science will be the greatest force in history for democratizing research. Seizing this moment requires us to reinvigorate our research enterprises and leverage new institutional models for discovery. Under President Trump's leadership, the United States is leading that charge, and the Kyoto Vision shows the world is ready to move forward with us.",
      "is_quote": true,
      "signal": "policy_announcement",
      "stance": 1,
      "source_url": "https://www.whitehouse.gov/releases/2026/10/us-leads-international-coalition-to-endorse-kyoto-vision-for-a-golden-age-of-science/"
    },
    {
      "id": "st_a0aa4bd911cf",
      "speaker": "Thomas \"Tommy\" Pigott",
      "role": "Spokesman",
      "date": "2026-10-03",
      "text": "Increasing cross-border tensions between Ethiopia and Eritrea have the potential to affect the entire region.",
      "is_quote": true,
      "signal": "warning",
      "stance": 0,
      "source_url": "https://www.state.gov/releases/office-of-the-spokesman/2026/10/u-s-statement-on-increased-tensions-between-ethiopia-and-eritrea/"
    },
    {
      "id": "st_7597e06a0d96",
      "speaker": "Thomas \"Tommy\" Pigott",
      "role": "Spokesman",
      "date": "2026-10-03",
      "text": "The Horn of Africa cannot sustain another military conflict and humanitarian crisis.",
      "is_quote": true,
      "signal": "warning",
      "stance": 0,
      "source_url": "https://www.state.gov/releases/office-of-the-spokesman/2026/10/u-s-statement-on-increased-tensions-between-ethiopia-and-eritrea/"
    },
    {
      "id": "st_47cfb4755a6c",
      "speaker": "Thomas \"Tommy\" Pigott",
      "role": "Spokesman",
      "date": "2026-10-03",
      "text": "A conflict jeopardizes ongoing U.S. collaboration on shared interests with both countries.",
      "is_quote": true,
      "signal": "warning",
      "stance": 0,
      "source_url": "https://www.state.gov/releases/office-of-the-spokesman/2026/10/u-s-statement-on-increased-tensions-between-ethiopia-and-eritrea/"
    },
    {
      "id": "st_5c22097dfc2b",
      "speaker": "Thomas \"Tommy\" Pigott",
      "role": "Spokesman",
      "date": "2026-10-03",
      "text": "We strongly urge Ethiopia and Eritrea to respect the sovereignty and territorial integrity of their neighbors, exercise maximum restraint and return to dialogue and cooperation as agreed in their 2018 peace framework.",
      "is_quote": true,
      "signal": "demand",
      "stance": 0,
      "source_url": "https://www.state.gov/releases/office-of-the-spokesman/2026/10/u-s-statement-on-increased-tensions-between-ethiopia-and-eritrea/"
    },
    {
      "id": "st_8444aef7338c",
      "speaker": "Thomas \"Tommy\" Pigott",
      "role": "Spokesman",
      "date": "2026-10-03",
      "text": "Peace through dialogue is the only path toward sustainable security, economic growth, and prosperity.",
      "is_quote": true,
      "signal": "policy_announcement",
      "stance": 1,
      "source_url": "https://www.state.gov/releases/office-of-the-spokesman/2026/10/u-s-statement-on-increased-tensions-between-ethiopia-and-eritrea/"
    }
  ],
