  "statements": [
    {
      "id": "st_e3bc59417e90",
      "speaker": "Delegate of Spain",
      "role": "Delegate to the UN",
      "date": "2026-10-09",
      "text": "Said Spain is the victim of a historical anachronism, that Gibraltar was militarily occupied by the United Kingdom during the War of the Spanish Succession, that the UK later extended control into the isthmus and built a military airfield extending into Spanish territorial waters thus occupying Spanish land, sea and airspace, cited Assembly resolutions calling for decolonization of Gibraltar, and said Spain remains open to dialogue.",
      "is_quote": false,
      "signal": "accusation",
      "stance": -1,
      "source_url": "https://press.un.org/en/2026/gaspd838.doc.htm"
    }
