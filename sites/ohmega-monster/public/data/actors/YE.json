  "statements": [
    {
      "id": "st_2b4c53c3cf1c",
      "speaker": "Abdullah Ali Fadhel Al-Saadi",
      "role": "Ambassador to the United Nations",
      "date": "2026-10-09",
      "text": "The objective of this operation is to end the war, to recover security, stability and peace in Yemen and the region,",
      "is_quote": true,
      "signal": "policy_announcement",
      "stance": -1,
      "source_url": "https://press.un.org/en/2026/sc16471.doc.htm"
    },
    {
      "id": "st_130745ac23f0",
      "speaker": "Abdullah Ali Fadhel Al-Saadi",
      "role": "Ambassador to the United Nations",
      "date": "2026-10-09",
      "text": "The threat of the Houthis is no longer an internal Yemeni affair that can be contained within our borders",
      "is_quote": true,
      "signal": "accusation",
      "stance": -1,
      "source_url": "https://press.un.org/en/2026/sc16471.doc.htm"
    },
    {
      "id": "st_9e9bf87c8383",
      "speaker": "Representative of Yemen",
      "role": "Delegate to the Third Committee",
      "date": "2026-10-02",
      "text": "Yemen's delegate accused Houthi militias of waging war since 2014 with severe humanitarian consequences, including killings, abductions, arbitrary detention, torture, restrictions on expression, property seizures and child recruitment in areas under their control.",
      "is_quote": false,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://press.un.org/en/2026/gashc4437.doc.htm"
    }
