  "statements": [
    {
      "id": "st_b91b8e2dbd0a",
      "speaker": "Recep Tayyip Erdogan",
      "role": "President",
      "date": "2026-10-09",
      "text": "International peace and security cannot be established without justice.",
      "is_quote": true,
      "signal": "accusation",
      "stance": -1,
      "source_url": "https://www.tccb.gov.tr/en/news/542/166492/-international-peace-and-security-cannot-be-established-without-justice-"
    },
    {
      "id": "st_84032e9e8d8c",
      "speaker": "Recep Tayyip Erdogan",
      "role": "President",
      "date": "2026-10-09",
      "text": "Today, we are unfortunately faced with an international system that is heavily wounded in terms of representation, function and legitimacy, and has experienced an erosion of trust and prestige.",
      "is_quote": true,
      "signal": "accusation",
      "stance": -1,
      "source_url": "https://www.tccb.gov.tr/en/news/542/166492/-international-peace-and-security-cannot-be-established-without-justice-"
    },
    {
      "id": "st_f08ecd577318",
      "speaker": "Recep Tayyip Erdogan",
      "role": "President",
      "date": "2026-10-09",
      "text": "We all know that a structure where the will of over 190 countries under the roof of the United Nations is bound by just five countries that hold veto prerogative is not fair and sound.",
      "is_quote": true,
      "signal": "demand",
      "stance": -1,
      "source_url": "https://www.tccb.gov.tr/en/news/542/166492/-international-peace-and-security-cannot-be-established-without-justice-"
    },
    {
      "id": "st_20c4a0627224",
      "speaker": "Recep Tayyip Erdogan",
      "role": "President",
      "date": "2026-10-09",
      "text": "International law has almost been suspended.",
      "is_quote": true,
      "signal": "accusation",
      "stance": -1,
      "source_url": "https://www.tccb.gov.tr/en/news/542/166492/-international-peace-and-security-cannot-be-established-without-justice-"
    },
    {
      "id": "st_c95e3b8646ef",
      "speaker": "Recep Tayyip Erdogan",
      "role": "President",
      "date": "2026-10-09",
      "text": "The war between Russia and Ukraine, now well past its four and a half years, is still raging on with thousands of casualties every month.",
      "is_quote": true,
      "signal": "other",
      "stance": 0,
      "source_url": "https://www.tccb.gov.tr/en/news/542/166492/-international-peace-and-security-cannot-be-established-without-justice-"
    },
    {
      "id": "st_6d4335756d52",
      "speaker": "Recep Tayyip Erdogan",
      "role": "President",
      "date": "2026-10-09",
      "text": "The bottleneck in the Strait of Hormuz, through which 35 percent of global oil exports transit, couldn’t be resolved for months despite all the efforts exerted.",
      "is_quote": true,
      "signal": "accusation",
      "stance": 0,
      "source_url": "https://www.tccb.gov.tr/en/news/542/166492/-international-peace-and-security-cannot-be-established-without-justice-"
    },
    {
      "id": "st_b6e25f43f26b",
      "speaker": "Recep Tayyip Erdogan",
      "role": "President",
      "date": "2026-10-09",
      "text": "Gaza has been turned into the world’s largest concentration camp by a radical and arrogant genocidal network that considers itself above international law and cannot get enough of killing.",
      "is_quote": true,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://www.tccb.gov.tr/en/news/542/166492/-international-peace-and-security-cannot-be-established-without-justice-"
    },
    {
      "id": "st_80fc2ab60048",
      "speaker": "Recep Tayyip Erdogan",
      "role": "President",
      "date": "2026-10-09",
      "text": "This ceasefire has been violated thousands of times by the Israeli government while our Palestinian brothers and sisters have abided by it.",
      "is_quote": true,
      "signal": "accusation",
      "stance": -2,
      "source_url": "https://www.tccb.gov.tr/en/news/542/166492/-international-peace-and-security-cannot-be-established-without-justice-"
    }
  ],
