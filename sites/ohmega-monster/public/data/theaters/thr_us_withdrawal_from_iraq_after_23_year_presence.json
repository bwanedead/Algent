  "timeline": [
    {
      "date": "2026-10-01",
      "headline": "Baghdad declares full sovereignty and sets June 2027 deadline for weapons outside state control",
      "detail": "On October 1, 2026, al-Zaidi issued a formal statement congratulating Iraqis on complete and final withdrawal of international coalition forces by land, air and sea and attainment of full sovereignty. He said October 1 marks a serious beginning to address weapons outside state control under a roadmap not extending beyond June 30, 2027, including disarming all non-Iraqi armed groups, purchasing a complete air-defense system, and enacting a Popular Mobilization Forces law placing the PMF under the Commander-in-Chief.",
      "where": "Baghdad, Iraq",
      "verification": "researched",
