        "Israel",
        "United Nations Security Council"
      ],
      "about_iso2": [
        "US",
        "IL"
      ],
      "signal": "accusation",
      "stance": -2,
      "significance": "Direct accusation by Iran against two Security Council-linked powers for a specific lethal strike, challenging Security Council credibility and IHL enforcement.",
      "url": "https://press.un.org/en/2026/gashc4437.doc.htm"
    },
    {
      "id": "st_75e6c8950625",
      "speaker": "Representative of Iran",
      "role": "Delegate to the Third Committee",
      "affiliation": "Iran",
      "iso2": "IR",
      "date": "2026-10-02",
      "venue": "other",
      "quote": "Silence, Mr. Chair, is a position. Selective outrage is not a principle. It is complicity dressed as diplomacy.",
      "paraphrase": "Iran's representative condemned the lack of an emergency debate after the alleged 28 February attack and said silence and selective outrage constitute complicity.",
      "about": [
