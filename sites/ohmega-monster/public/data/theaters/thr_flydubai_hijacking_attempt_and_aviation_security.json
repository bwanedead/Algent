  "timeline": [
    {
      "date": "2026-10-04",
      "headline": "Netanyahu orders systemic security review of foreign flights to Israel",
      "detail": "On 4 October Netanyahu instructed Ben Ezra to appoint an examiner to conduct a thorough review of all security aspects of foreign civil aviation to Israel. Opposition leader Yair Lapid on 4 October called it a 'sham investigation' and said the chain of failures could have led to historic disaster. Transport Minister Miri Regev said oversight for foreign airlines falls to Mossad and Shin Bet, while critics including former Transport Ministry DG Keren Terner said responsibility lies with the ministry/Civil Aviation Authority.",
      "where": "Jerusalem, Israel",
      "verification": "researched",
      "sources": [
        "https://www.arabnews.com/middle-east/netanyahu-orders-security-review-of-international-flights-to-israel-after-flydubai-attack-3004607",
        "https://www.dawn.com/news/2034750"
      ],
      "from": "/geopolitics/2026-10-04"
    },
    {
      "date": "2026-10-04",
      "headline": "Co-pilot in UAE custody with Israeli participation; Australia opens vetting probe",
      "detail": "The co-pilot was detained at Tabuk and transferred to UAE custody on 2 October, where interrogation is underway with Israeli representatives participating. On 4-5 October the Victorian Joint Counter Terrorism Team confirmed it is investigating the man's links to Australia; sourced reports say he held an Australian student visa issued 2014, studied in Melbourne (RMIT cited) 2015-2017, left Australia and had visa cancelled 2019 for non-enrolment. Multiple sourced reports identify him as Omani national Hamam al-Hammami, 29, and report Omani authorities had previously banned him from flying and removed him from Oman Air duties over radical ideological views — both points remain likely, not confirmed, and CBS sources said FlyDubai hired him without vetting with Oman. Early Israeli assessment per CBS sources on 4 October is likely lone-wolf, though all avenues open; US President Donald Trump on 2 October suggested a possible Iran link 'based on what I'm hearing'.",
      "where": "Tabuk, Saudi Arabia",
      "verification": "researched",
      "sources": [
        "https://www.cbsnews.com/news/flydubai-co-pilot-alleged-hijacking-lone-wolf/",
        "https://www.dawn.com/news/2034750",
        "https://www.bbc.com/news/articles/cqjdv7pmj9dno",
        "https://www.jpost.com/international/islamic-terrorism/article-910529"
      ],
      "from": "/geopolitics/2026-10-04"
    },
    {
      "date": "2026-10-03",
      "headline": "UAE designates co-pilot attack as attempted terrorist act",
      "detail": "On 3 October Al Shamsi said investigations found the co-pilot attempted to commit a terrorist act, attacking Captain Smit Machchhar with a crash axe and attempting to take control of the Boeing 737 MAX. He said investigations continue into motives, links and technical/digital evidence. Emirati presidential adviser Anwar Gargash on 3 October called it a terrorist operation and warning that confrontation with extremism has not ended.",
      "where": "Abu Dhabi, United Arab Emirates",
      "verification": "researched",
      "sources": [
        "https://www.chinadaily.com.cn/a/202610/03/WS6ac0b21ce4b06d4aa05614d4.html",
        "https://www.france24.com/en/middle-east/20261003-co-pilot-on-flydubai-flight-was-banned-from-flying-by-oman-for-holding-extremist-views",
        "https://www.dw.com/en/co-pilot-on-flydubai-flight-was-banned-from-flying-by-oman/a-79526641"
      ],
      "from": "/geopolitics/2026-10-04"
    },
    {
      "date": "2026-10-02",
      "headline": "Tel Aviv route remains suspended as Israel plans stricter pilot checks",
      "detail": "FlyDubai suspended flights to/from Tel Aviv on 30 September at authorities' request/recommendation of Shin Bet pending investigation; CEO Ghaith Al Ghaith said suspension allows authorities to establish facts. Israeli officials said they will ramp up security checks on pilots flying into Israel, requiring identity verification and security checks for every pilot on Israel-bound flights. Captain Smit Machchhar (Indian national, ex-SpiceJet, joined FlyDubai 2022) and the co-pilot were hospitalized in Tabuk; Machchhar was reported stable and later transferred to Abu Dhabi.",
      "where": "Ben Gurion Airport, Israel",
      "verification": "researched",
      "sources": [
        "https://www.flightradar24.com/blog/flight-tracking-news/major-incident/flydubai-flight-to-tel-aviv-diverts-to-tabuk-amid-onboard-incident",
