        "IL"
      ],
      "signal": "accusation",
      "stance": -2,
      "significance": "Signals Iranian effort to frame UN inaction as political bias favoring Western powers.",
      "url": "https://press.un.org/en/2026/gashc4437.doc.htm"
    },
