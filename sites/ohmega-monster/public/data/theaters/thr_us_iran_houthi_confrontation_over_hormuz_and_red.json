  "timeline": [
    {
      "date": "2026-10-02",
      "headline": "Red Sea chokepoint stays under Houthi control as allies move to protect Yanbu",
      "detail": "Red Sea pressure sustained: Houthis seized entire Red Sea coast and Mayun (Perim) island in Bab el-Mandeb 11 Sept and declared navigation safe except for Saudi vessels. Saudi East-West pipeline (1,200 km Abqaiq-Yanbu, 5m b/d) struck by drones and mostly out for weeks as of mid-Sept. France said it will send soldiers, radar and air defence to Yanbu; Italy will secure merchant ships via Operation Aspides. UN Envoy Grundberg 2 Oct urged both sides to contain escalation in Taiz and ensure civilian movement.",
      "where": "Bab el-Mandeb / Yanbu / Taiz",
      "verification": "researched",
      "sources": [
        "https://www.npr.org/2026/09/12/g-s1-143044/yemens-houthis-capture-red-sea-island",
        "https://www.dw.com/en/saudi-arabia-faces-hard-choices-as-houthis-gain-in-yemen/a-79274826",
        "https://www.dw.com/en/are-the-houthis-winning-against-saudi-arabia/a-79492476",
        "https://www.eia.gov/todayinenergy/detail.php?id=65504"
      ],
      "from": "/geopolitics/2026-10-03"
    },
    {
      "date": "2026-10-02",
      "headline": "Hormuz diplomatic deadlock persists with no formal US reply via mediators",
      "detail": "Iran's seven-day plan presented 25 Sept in New York via Qatari mediators — reopen Hormuz and resume nuclear talks if US lifts naval blockade, waives oil sanctions, releases frozen assets and observes regional ceasefire — remains without a formal US reply via mediators as of 26-27 Sept statements. Trump publicly rejected it 26 Sept outside the White House as 'not acceptable.' Timeline would have been US actions in 4-5 days, strait open day 6, talks day 7.",
      "where": "New York / Washington",
      "verification": "researched",
      "sources": [
        "https://www.aljazeera.com/news/2026/9/26/trump-rejects-irans-seven-day-roadmap-to-reopen-strait-of-hormuz",
