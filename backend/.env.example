# Algent API keys — copy to backend/.env and fill in what you have.
# backend/.env is gitignored; never commit real keys.
#
# Precedence: real environment variables > this file > OS keyring.
# Every key is optional — a missing key only disables the tools/models that need it.

# --- Model providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# xAI powers both Grok models and the x_search sourcing tool (live X/web search).
XAI_API_KEY=

# --- Sourcing services (tools) ---
# Tavily — keyword web/news search (tools: web_search). https://tavily.com
TAVILY_API_KEY=
# Exa — semantic/neural search for niche discovery (tools: semantic_search). https://exa.ai
EXA_API_KEY=
# Brave — independent-index web search (tools: brave_search). https://brave.com/search/api/
BRAVE_API_KEY=
# Firecrawl — fallback extraction for hard/JS-heavy pages (tools: fetch_content). https://firecrawl.dev
FIRECRAWL_API_KEY=

# RSS (rss_feed) and GDELT (gdelt_events) need no keys.

# --- Observability (optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
