# Algent API keys — copy to backend/.env and fill in what you have.
# backend/.env is gitignored; never commit real keys.
#
# Precedence: real environment variables > this file > OS keyring.
# Every key is optional — a missing key only disables the tools/models that need it.

# --- Model providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# xAI: Grok models + Grok-mediated X search (xai_x_search). SEPARATE from native X API.
XAI_API_KEY=

# --- Sourcing services (tools) ---
# Tavily — keyword web/news search (web_search). https://tavily.com
TAVILY_API_KEY=
# Exa — semantic/neural search (semantic_search). https://exa.ai
EXA_API_KEY=
# Brave — independent-index web search (brave_search). https://brave.com/search/api/
BRAVE_API_KEY=
# Firecrawl — fallback extraction for hard/JS pages (fetch_content). https://firecrawl.dev
FIRECRAWL_API_KEY=
# RSS (rss_feed) and GDELT (gdelt_events) need no keys.
# Scholarly resolve (Crossref/OpenAlex via web_search doi= / kind=scholar) needs no keys.

# --- Optional fetch knobs (fetch_content) ---
# ALGENT_FETCH_PLAYWRIGHT=0   # default OFF. Set 1 only if playwright+chromium are installed;
#                             # JS render is heavy on low-end machines.
# ALGENT_FETCH_CACHE=1        # default ON. Disk cache under backend/.cache/fetch/

# --- Cost ceilings (full-rail article envelope) ---
# ALGENT_ARTICLE_SOFT_CAP_USD=1.00  # enter slim_finish — finish cheaply, still publish
# ALGENT_ARTICLE_HARD_CAP_USD=3.00  # refuse every new billable op
# ALGENT_ARTICLE_CAP_USD=3.00       # legacy alias for HARD_CAP

# --- X API (read-only discovery) ---
X_BEARER_KEY=
X_CONSUMER_KEY=
X_SECRET_KEY=

# --- X posting (later, separate) ---
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Observability (optional) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
